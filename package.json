{
  "name": "neverssh",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Local MCP tools for remote development over your existing OpenSSH connection.",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "check": "bunx tsc --noEmit",
    "test": "bun test",
    "docs:sync": "bun run scripts/sync-interface-docs.ts",
    "docs:check": "bun run scripts/sync-interface-docs.ts --check",
    "build": "bun build src/index.ts --target=bun --outdir=dist"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/bun": "^1.4.3",
    "@types/ssh2": "^1.15.6",
    "ssh2": "^1.17.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jacko-John/NeverSSH.git"
  },
  "homepage": "https://github.com/Jacko-John/NeverSSH"
}
