#!/bin/sh
# Resolve the latest NeverSSH GitHub release, cache its Bun bundle, and start it.
set -eu

REPO="Jacko-John/NeverSSH"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/neverssh"
LATEST_FILE="$CACHE/latest"
mkdir -p "$CACHE"
chmod 700 "$CACHE" 2>/dev/null || true

# Keep interrupted downloads and pointer updates out of the reusable cache.
TMP=""
LATEST_TMP=""
cleanup() {
  if [ -n "$TMP" ]; then rm -f "$TMP"; fi
  if [ -n "$LATEST_TMP" ]; then rm -f "$LATEST_TMP"; fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# Only a complete cached bundle can serve as the last known working release.
CACHED_TAG=""
if [ -f "$LATEST_FILE" ]; then CACHED_TAG=$(cat "$LATEST_FILE"); fi
case "$CACHED_TAG" in
  */*) CACHED_TAG="" ;;
  v*) if [ ! -f "$CACHE/$CACHED_TAG/neverssh.js" ]; then CACHED_TAG=""; fi ;;
  *) CACHED_TAG="" ;;
esac

TAG=""
PUBLISH_LATEST=false
if URL=$(curl --proto '=https' --tlsv1.2 -fsSLI --connect-timeout 5 --max-time 15 \
    -o /dev/null -w '%{url_effective}' "https://github.com/$REPO/releases/latest" 2>/dev/null); then
  TAG=${URL##*/}
  case "$TAG" in
    */*) TAG="" ;;
    v*) PUBLISH_LATEST=true ;;
    *) TAG="" ;;
  esac
fi
if [ -z "$TAG" ]; then TAG="$CACHED_TAG"; fi
case "$TAG" in
  v*) ;;
  *) echo "neverssh: cannot determine the latest release" >&2; exit 1 ;;
esac

DIR="$CACHE/$TAG"
FILE="$DIR/neverssh.js"
if [ ! -f "$FILE" ]; then
  mkdir -p "$DIR"
  chmod 700 "$DIR" 2>/dev/null || true
  TMP=$(mktemp "$FILE.XXXXXX")
  if curl --proto '=https' --tlsv1.2 -fsSL --connect-timeout 10 --max-time 120 \
      "https://github.com/$REPO/releases/download/$TAG/neverssh.js" -o "$TMP" && \
      chmod 600 "$TMP" && mv -f "$TMP" "$FILE"; then
    TMP=""
  elif [ -n "$CACHED_TAG" ]; then
    echo "neverssh: cannot cache $TAG; using cached $CACHED_TAG" >&2
    TAG="$CACHED_TAG"
    FILE="$CACHE/$TAG/neverssh.js"
    PUBLISH_LATEST=false
  else
    echo "neverssh: cannot cache $TAG and no previous release is available" >&2
    exit 1
  fi
fi

# Publish only usable releases, replacing the pointer atomically for concurrent launchers.
if [ "$PUBLISH_LATEST" = true ]; then
  LATEST_TMP=$(mktemp "$CACHE/latest.XXXXXX")
  printf '%s\n' "$TAG" > "$LATEST_TMP"
  mv -f "$LATEST_TMP" "$LATEST_FILE"
  LATEST_TMP=""
fi

cleanup
trap - EXIT HUP INT TERM
exec bun "$FILE" "$@"
